rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Assuming admins have a specific role or custom claim
      // Or looking up the user doc (requires extra read, use cautiously)
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public content (e.g. tracks, podcasts, genres, plans)
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /podcasts/{podcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User data
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own profile, but NOT role or subscription details
      allow update: if isOwner(userId) && 
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSubscribed', 'subscriptionExpiry']));
      
      allow create: if isOwner(userId) && 
                       (!request.resource.data.keys().hasAny(['role', 'isSubscribed', 'subscriptionExpiry']) || request.resource.data.role == 'listener');
      
      allow delete: if isAdmin();
      
      // Sub-collections for users (favorites, history, playlists)
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }
      match /playlists/{playlistId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Subscription & Payment Records
    // Only backend (Admin SDK) should write to these. Users can read their own.
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only Admin SDK
    }
    
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only Admin SDK
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false; // Only Admin SDK
    }
  }
}
