rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function roleIn(roles) {
      return signedIn() && (
        request.auth.token.admin == true ||
        roles.hasAny([request.auth.token.role]) ||
        roles.hasAny([get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role])
      );
    }
    function admin() { return roleIn(['ADMIN','SUPER_ADMIN','EDITOR','MODERATOR']); }
    function superAdmin() { return roleIn(['SUPER_ADMIN']); }
    function protectedEntitlementKeys() {
      return ['role','isSubscribed','subscriptionStatus','subscriptionExpiry','subscriptionPlanId','subscriptionPlanName','subscriptionPlanInterval','trialUsed','trialStartedAt','trialEndsAt','banned','suspended','premiumGrantedBy','premiumGrantedAt','premiumRevokedBy','premiumRevokedAt','coinBalance'];
    }

    match /{document=**} { allow read, write: if false; }

    match /tracks/{id} { allow read: if resource.data.status == 'PUBLISHED'; allow write: if admin(); }
    match /albums/{id} { allow read: if resource.data.status == 'PUBLISHED'; allow write: if admin(); }
    match /artists/{id} { allow read: if resource.data.status == 'PUBLISHED'; allow write: if admin(); }
    match /podcasts/{id} { allow read: if resource.data.status == 'PUBLISHED'; allow write: if admin(); }
    match /episodes/{id} { allow read: if resource.data.status == 'PUBLISHED'; allow write: if admin(); }
    match /genres/{id} { allow read: if true; allow write: if admin(); }
    match /plans/{id} { allow read: if resource.data.active == true; allow write: if admin(); }
    match /tasks/{id} { allow read: if resource.data.active == true; allow write: if admin(); }
    match /taskClaims/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
    match /coinLedger/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid || admin(); allow write: if false; }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.role == 'USER'
        && !request.resource.data.keys().hasAny(protectedEntitlementKeys());
      allow update: if superAdmin()
        || (owner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedEntitlementKeys()));
      allow delete: if superAdmin();
      match /favorites/{id} { allow read, write: if owner(uid); }
      match /history/{id} { allow read, write: if owner(uid); }
      match /playlists/{id} { allow read, write: if owner(uid); }
    }

    match /subscriptions/{id} { allow read: if (signedIn() && resource.data.userId == request.auth.uid) || admin(); allow write: if false; }
    match /payments/{id} { allow read: if (signedIn() && resource.data.userId == request.auth.uid) || admin(); allow write: if false; }
    match /orders/{id} { allow read: if (signedIn() && resource.data.userId == request.auth.uid) || admin(); allow write: if false; }
    match /streams/{id} { allow read: if admin(); allow write: if false; }
    match /webhookEvents/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
    match /securityEvents/{id} { allow read: if admin(); allow write: if false; }
    match /notifications/{id} { allow read, write: if admin(); }
    match /reports/{id} { allow read, write: if admin(); }
    match /systemConfig/{id} { allow read: if admin(); allow write: if superAdmin(); }
    match /roles/{id} { allow read: if admin(); allow write: if superAdmin(); }
    match /tournaments/{id} { allow read: if signedIn(); allow write: if false; match /entries/{uid} { allow read: if owner(uid) || admin(); allow write: if false; } }
  }
}
